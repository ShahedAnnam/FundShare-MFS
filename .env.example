# FUNDShare Environment Configuration
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_DEMO_RESET=False
ENABLE_SIMULATED_CASH_IN=True
DATABASE_URL=postgresql://fundshare:replace-with-a-random-password@127.0.0.1:5432/fundshare
# Required with DEBUG=False:
# REDIS_URL=redis://localhost:6379/0
# TRUST_PROXY_HTTPS=True

# Optional: Google Gemini API Key for extended generative natural language responses in AI Coach
# Demo Q&A always works locally; if omitted, live questions use local financial analytics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
